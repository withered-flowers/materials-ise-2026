---
import { quizQuestions } from '../data/quiz-data';
import Leaderboard from './Leaderboard.astro';
---

<div id="quiz-container" class="quiz-root">
  <!-- LEADERBOARD MODAL COMPONENT -->
  <Leaderboard />

  <!-- QUIZ ACCESS ACTIVE BANNER (SHOWN WHEN UNLOCKED) -->
  <div id="quiz-active-banner" class="quiz-active-banner" style="display: none;">
    <div class="active-badge-info">
      <span>🔓 Mode Kuis: <strong>Aktif</strong> (Diakses via <code>?quiz=enabled</code>)</span>
    </div>
    <div class="active-banner-actions">
      <button id="btn-open-leaderboard-top" class="quiz-btn quiz-btn-secondary" type="button">
        🏆 Papan Peringkat
      </button>
      <button id="btn-lock-quiz" class="quiz-lock-btn" type="button" title="Sembunyikan kuis kembali">
        🔒 Kunci / Sembunyikan
      </button>
    </div>
  </div>

  <!-- QUIZ GATE CARD (SHOWN WHEN LOCKED / DEFAULT) -->
  <div id="quiz-gate-card" class="quiz-gate-card" style="display: none;">
    <div class="quiz-gate-icon">🔒</div>
    <h2 class="quiz-gate-title">Kuis Evaluasi Terkunci</h2>
    <p class="quiz-gate-desc">
      Bagian kuis evaluasi ini disembunyikan secara default. Untuk membuka kuis ini, silakan akses halaman dengan menambahkan query parameter <code>?quiz=enabled</code> pada URL atau klik tombol di bawah ini.
    </p>
    <div class="quiz-gate-actions">
      <button id="btn-unlock-gate" class="quiz-gate-btn" type="button">
        🔓 Buka Akses Kuis Sekarang
      </button>
    </div>
  </div>

  <!-- MAIN QUIZ AREA (HIDDEN WHEN LOCKED) -->
  <div id="quiz-main-area" style="display: none;">
    <!-- QUIZ TOP CONTROL BAR / STICKY HEADER -->
    <div class="quiz-sticky-header">
      <div class="quiz-header-content">
        <div class="quiz-header-left">
          <span class="quiz-title-badge">🎯 Quiz Netlify</span>
          <div class="quiz-progress-info">
            <span id="answered-count-text">Terjawab: <strong>0</strong> / {quizQuestions.length}</span>
            <div class="quiz-progress-bar-wrapper">
              <div id="quiz-progress-bar" class="quiz-progress-bar" style="width: 0%;"></div>
            </div>
          </div>
        </div>

        <div class="quiz-header-right">
          <div class="quiz-timer-box" id="timer-box" title="Waktu pengerjaan (Maksimal 30:00)">
            <span class="timer-icon">⏱️</span>
            <span id="timer-display" class="timer-display">00:00 / 30:00</span>
          </div>
          <button id="btn-show-leaderboard-header" class="quiz-btn quiz-btn-secondary" type="button" title="Lihat Papan Peringkat">
            🏆 Leaderboard
          </button>
          <button id="btn-submit-top" class="quiz-btn quiz-btn-primary" type="button">
            Kirim Jawaban
          </button>
          <button id="btn-reset-top" class="quiz-btn quiz-btn-secondary" type="button" title="Mulai ulang quiz">
            🔄 Reset
          </button>
        </div>
      </div>
    </div>

    <!-- RESULT DASHBOARD (HIDDEN UNTIL SUBMISSION) -->
    <div id="quiz-result-dashboard" class="quiz-result-dashboard" style="display: none;">
      <div class="result-card">
        <div class="result-header">
          <div class="result-badge-container">
            <div id="result-score-circle" class="result-score-circle">
              <span id="result-score-number" class="score-number">0</span>
              <span class="score-max">/ 100</span>
            </div>
          </div>
          <div class="result-summary-text">
            <h2 id="result-status-title" class="result-status-title">Hasil Quiz</h2>
            <p id="result-status-message" class="result-status-message">Menghitung hasil...</p>
            <div class="result-meta">
              <span id="result-time-spent" class="meta-item">⏱️ Waktu Pengerjaan: 00:00</span>
              <span id="result-timestamp" class="meta-item">📅 Tanggal: -</span>
            </div>
          </div>
        </div>

        <!-- STATS GRID -->
        <div class="result-stats-grid">
          <div class="stat-card stat-correct">
            <span class="stat-icon">✅</span>
            <span class="stat-label">Jawaban Benar</span>
            <span id="stat-correct-count" class="stat-value">0</span>
          </div>
          <div class="stat-card stat-incorrect">
            <span class="stat-icon">❌</span>
            <span class="stat-label">Jawaban Salah</span>
            <span id="stat-incorrect-count" class="stat-value">0</span>
          </div>
          <div class="stat-card stat-unanswered">
            <span class="stat-icon">⚠️</span>
            <span class="stat-label">Tidak Dijawab</span>
            <span id="stat-unanswered-count" class="stat-value">0</span>
          </div>
          <div class="stat-card stat-accuracy">
            <span class="stat-icon">📊</span>
            <span class="stat-label">Akurasi</span>
            <span id="stat-accuracy-rate" class="stat-value">0%</span>
          </div>
        </div>

        <!-- SUBMIT TO LEADERBOARD FORM CARD -->
        <div class="leaderboard-submit-card" id="leaderboard-submit-section">
          <h3 class="lb-form-title">🏆 Daftarkan Skor ke Papan Peringkat (Leaderboard)</h3>
          <p class="lb-form-subtitle">Simpan nama dan perolehan skor Anda ke database Turso.</p>

          <form id="leaderboard-form" class="lb-form-body">
            <div class="lb-form-fields">
              <div class="lb-input-group">
                <label for="input-player-name">Nama Peserta *</label>
                <input
                  type="text"
                  id="input-player-name"
                  class="lb-input"
                  placeholder="Masukkan nama Anda..."
                  maxlength="50"
                  required
                />
              </div>
              <div class="lb-input-group">
                <label for="input-player-email">Email (Opsional)</label>
                <input
                  type="email"
                  id="input-player-email"
                  class="lb-input"
                  placeholder="email@contoh.com"
                  maxlength="100"
                />
              </div>
            </div>

            <div class="lb-form-action-row">
              <button type="submit" id="btn-submit-score-lb" class="quiz-btn quiz-btn-primary">
                Simpan ke Leaderboard
              </button>
              <button type="button" id="btn-view-leaderboard-direct" class="quiz-btn quiz-btn-secondary">
                Lihat Papan Peringkat
              </button>
            </div>
            
            <div id="lb-submit-feedback" class="lb-submit-feedback" style="display: none;"></div>
          </form>
        </div>

        <!-- MODULE BREAKDOWN -->
        <div class="module-breakdown-section">
          <h3>📋 Evaluasi Pemahaman per Topik / Modul</h3>
          <div id="module-breakdown-list" class="module-breakdown-list">
            <!-- Dynamically inserted via JS -->
          </div>
        </div>

        <div class="result-actions">
          <button id="btn-restart-quiz" class="quiz-btn quiz-btn-primary" type="button">
            🔄 Ulangi Quiz
          </button>
          <button id="btn-open-leaderboard-result" class="quiz-btn quiz-btn-secondary" type="button">
            🏆 Lihat Leaderboard
          </button>
          <button id="btn-scroll-to-questions" class="quiz-btn quiz-btn-secondary" type="button">
            🔍 Pelajari Pembahasan Soal
          </button>
        </div>
      </div>
    </div>

    <!-- QUESTION NAVIGATION GRID -->
    <div class="quiz-nav-card">
      <div class="quiz-nav-header">
        <span class="quiz-nav-title">📌 Navigasi Nomor Soal</span>
        <div class="quiz-nav-legend">
          <span class="legend-item"><span class="legend-dot dot-unanswered"></span> Belum</span>
          <span class="legend-item"><span class="legend-dot dot-answered"></span> Terisi</span>
          <span class="legend-item review-only" style="display: none;"><span class="legend-dot dot-correct"></span> Benar</span>
          <span class="legend-item review-only" style="display: none;"><span class="legend-dot dot-incorrect"></span> Salah</span>
        </div>
      </div>
      <div class="quiz-nav-grid" id="quiz-nav-grid">
        {quizQuestions.map((q) => (
          <button
            type="button"
            class="quiz-nav-btn"
            data-question-target={q.id}
            id={`nav-btn-${q.id}`}
          >
            {q.id}
          </button>
        ))}
      </div>
    </div>

    <!-- MODULE FILTER TABS -->
    <div class="quiz-filter-tabs">
      <button type="button" class="filter-tab active" data-filter="all">Semua ({quizQuestions.length})</button>
      <button type="button" class="filter-tab" data-filter="Modul 1">Modul 1 (4)</button>
      <button type="button" class="filter-tab" data-filter="Modul 2">Modul 2 (5)</button>
      <button type="button" class="filter-tab" data-filter="Modul 3">Modul 3 (5)</button>
      <button type="button" class="filter-tab" data-filter="Modul 4">Modul 4 (5)</button>
      <button type="button" class="filter-tab" data-filter="Referensi">Referensi (1)</button>
    </div>

    <!-- QUESTIONS LIST -->
    <form id="quiz-form" class="quiz-questions-list">
      {quizQuestions.map((q) => (
        <article
          class="quiz-question-card"
          id={`question-card-${q.id}`}
          data-question-id={q.id}
          data-module-category={q.moduleCategory}
          data-correct-answer={q.correctAnswer}
        >
          <div class="question-card-header">
            <div class="question-badge-group">
              <span class="question-number-badge">Soal #{q.id}</span>
              <span class="question-module-badge">{q.module}</span>
            </div>
            <div class="question-status-badge" id={`status-badge-${q.id}`}>
              <!-- Benar / Salah will be shown here in review mode -->
            </div>
          </div>

          <div class="question-body">
            <h3 class="question-text">
              {q.question.replace(/\*(.*?)\*/g, '$1')}
            </h3>

            {q.codeSnippet && (
              <div class="quiz-code-block">
                <div class="code-block-header">
                  <span>{q.codeSnippet.language}</span>
                </div>
                <pre><code>{q.codeSnippet.code}</code></pre>
              </div>
            )}

            <div class="quiz-options-group" role="radiogroup" aria-labelledby={`question-card-${q.id}`}>
              {q.options.map((opt) => (
                <label
                  class="quiz-option-label"
                  id={`option-label-${q.id}-${opt.id}`}
                  for={`q${q.id}_opt_${opt.id}`}
                >
                  <input
                    type="radio"
                    id={`q${q.id}_opt_${opt.id}`}
                    name={`question_${q.id}`}
                    value={opt.id}
                    class="quiz-option-input"
                  />
                  <span class="option-letter">{opt.id}</span>
                  <span class="option-text">{opt.text}</span>
                  <span class="option-feedback-icon" id={`opt-icon-${q.id}-${opt.id}`}></span>
                </label>
              ))}
            </div>
          </div>

          <!-- REVIEW & EXPLANATION CALLOUT (HIDDEN UNTIL SUBMITTED) -->
          <div class="question-explanation" id={`explanation-${q.id}`} style="display: none;">
            <div class="explanation-content">
              <div class="explanation-key">
                <strong>🔑 Kunci Jawaban:</strong> Pilihan <span class="key-highlight">{q.correctAnswer}</span>
              </div>
              
              <!-- FEEDBACK BENAR -->
              <div class="feedback-box feedback-correct" id={`fb-correct-${q.id}`} style="display: none;">
                <strong>✅ Feedback Jawaban Benar:</strong>
                <p>{q.correctFeedback}</p>
              </div>

              <!-- FEEDBACK SALAH -->
              <div class="feedback-box feedback-incorrect" id={`fb-incorrect-${q.id}`} style="display: none;">
                <strong>💡 Feedback Jawaban Salah:</strong>
                <p>{q.incorrectFeedback}</p>
              </div>

              <div class="explanation-footer">
                <span class="ref-tag">📖 Modul Acuan: {q.reference}</span>
              </div>
            </div>
          </div>
        </article>
      ))}

      <!-- BOTTOM SUBMIT ACTIONS -->
      <div class="quiz-bottom-actions">
        <button type="button" id="btn-submit-bottom" class="quiz-btn quiz-btn-primary quiz-btn-large">
          🚀 Kirim Jawaban & Lihat Hasil
        </button>
        <button type="button" id="btn-reset-bottom" class="quiz-btn quiz-btn-secondary">
          🔄 Reset Jawaban
        </button>
      </div>
    </form>
  </div>
</div>

<!-- CLIENT JAVASCRIPT LOGIC -->
<script is:inline define:vars={{ quizData: quizQuestions }}>
(function () {
  const STORAGE_KEY_ACCESS = 'quiz_unlocked_v1';
  const STORAGE_KEY_ANSWERS = 'netlify_quiz_answers_v2';
  const STORAGE_KEY_SUBMITTED = 'netlify_quiz_submitted_v2';
  const STORAGE_KEY_TIMER_ELAPSED = 'netlify_quiz_timer_elapsed_v2';
  const STORAGE_KEY_RESULT = 'netlify_quiz_result_v2';
  const STORAGE_KEY_PLAYER_NAME = 'netlify_quiz_player_name_v1';
  const STORAGE_KEY_LB_SUBMITTED = 'netlify_quiz_lb_submitted_v1';

  const TOTAL_QUESTIONS = quizData.length;
  const MAX_DURATION_SECONDS = 30 * 60; // 30 Minutes limit (1800 seconds)

  let answers = {};
  let isSubmitted = false;
  let timerSecondsElapsed = 0;
  let timerInterval = null;
  let currentResultData = null;

  // DOM Elements
  const container = document.getElementById('quiz-container');
  if (!container) return;

  const gateCard = document.getElementById('quiz-gate-card');
  const mainQuizArea = document.getElementById('quiz-main-area');
  const activeBanner = document.getElementById('quiz-active-banner');
  const btnUnlockGate = document.getElementById('btn-unlock-gate');
  const btnLockQuiz = document.getElementById('btn-lock-quiz');

  const timerDisplay = document.getElementById('timer-display');
  const timerBox = document.getElementById('timer-box');
  const answeredCountText = document.getElementById('answered-count-text');
  const progressBar = document.getElementById('quiz-progress-bar');
  const btnSubmitTop = document.getElementById('btn-submit-top');
  const btnSubmitBottom = document.getElementById('btn-submit-bottom');
  const btnResetTop = document.getElementById('btn-reset-top');
  const btnResetBottom = document.getElementById('btn-reset-bottom');
  const btnRestartQuiz = document.getElementById('btn-restart-quiz');
  const btnScrollQuestions = document.getElementById('btn-scroll-to-questions');
  const resultDashboard = document.getElementById('quiz-result-dashboard');
  const quizForm = document.getElementById('quiz-form');
  const filterTabs = document.querySelectorAll('.filter-tab');

  // Leaderboard Triggers
  const btnOpenLbTop = document.getElementById('btn-open-leaderboard-top');
  const btnShowLbHeader = document.getElementById('btn-show-leaderboard-header');
  const btnOpenLbResult = document.getElementById('btn-open-leaderboard-result');
  const btnViewLbDirect = document.getElementById('btn-view-leaderboard-direct');

  // Leaderboard Form Elements
  const lbForm = document.getElementById('leaderboard-form');
  const inputPlayerName = document.getElementById('input-player-name');
  const inputPlayerEmail = document.getElementById('input-player-email');
  const btnSubmitScoreLb = document.getElementById('btn-submit-score-lb');
  const lbSubmitFeedback = document.getElementById('lb-submit-feedback');

  function openLeaderboard() {
    if (typeof window.openQuizLeaderboard === 'function') {
      window.openQuizLeaderboard();
    } else {
      window.dispatchEvent(new CustomEvent('open-quiz-leaderboard'));
    }
  }

  // Check access & Unlock gating
  function checkAccessState() {
    let isUnlocked = false;
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const quizParam = urlParams.get('quiz');
      if (quizParam === 'enabled' || quizParam === 'true' || quizParam === '1') {
        localStorage.setItem(STORAGE_KEY_ACCESS, 'true');
      } else if (quizParam === 'disabled' || quizParam === 'false' || quizParam === '0') {
        localStorage.removeItem(STORAGE_KEY_ACCESS);
      }
      isUnlocked = localStorage.getItem(STORAGE_KEY_ACCESS) === 'true';
    } catch (e) {
      console.warn('Storage check failed:', e);
    }

    if (isUnlocked) {
      document.documentElement.classList.add('quiz-unlocked');
      if (gateCard) gateCard.style.display = 'none';
      if (mainQuizArea) mainQuizArea.style.display = 'block';
      if (activeBanner) activeBanner.style.display = 'flex';
      initQuiz();
    } else {
      document.documentElement.classList.remove('quiz-unlocked');
      if (gateCard) gateCard.style.display = 'block';
      if (mainQuizArea) mainQuizArea.style.display = 'none';
      if (activeBanner) activeBanner.style.display = 'none';
      if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
      }
    }

    return isUnlocked;
  }

  // Initialize Quiz Logic
  function initQuiz() {
    loadStoredState();
    setupEventListeners();
    updateProgressUI();

    if (isSubmitted) {
      applyReviewMode();
    } else {
      startTimer();
    }
  }

  // Load state from localStorage
  function loadStoredState() {
    try {
      const savedAnswers = localStorage.getItem(STORAGE_KEY_ANSWERS);
      if (savedAnswers) {
        answers = JSON.parse(savedAnswers);
        Object.entries(answers).forEach(([qId, selectedOpt]) => {
          const input = document.querySelector(`input[name="question_${qId}"][value="${selectedOpt}"]`);
          if (input) {
            input.checked = true;
            markOptionSelected(qId, selectedOpt);
          }
        });
      }

      const savedSubmitted = localStorage.getItem(STORAGE_KEY_SUBMITTED);
      if (savedSubmitted === 'true') {
        isSubmitted = true;
      }

      const savedTimer = localStorage.getItem(STORAGE_KEY_TIMER_ELAPSED);
      if (savedTimer !== null) {
        timerSecondsElapsed = parseInt(savedTimer, 10);
        if (isNaN(timerSecondsElapsed) || timerSecondsElapsed < 0) {
          timerSecondsElapsed = 0;
        }
      }

      const savedPlayerName = localStorage.getItem(STORAGE_KEY_PLAYER_NAME);
      if (savedPlayerName && inputPlayerName) {
        inputPlayerName.value = savedPlayerName;
      }
    } catch (e) {
      console.warn('LocalStorage not accessible:', e);
    }
  }

  // Save answers to localStorage
  function saveAnswersState() {
    try {
      localStorage.setItem(STORAGE_KEY_ANSWERS, JSON.stringify(answers));
    } catch (e) {
      console.warn('Failed to save answers:', e);
    }
  }

  // Save timer to localStorage
  function saveTimerState() {
    try {
      localStorage.setItem(STORAGE_KEY_TIMER_ELAPSED, timerSecondsElapsed.toString());
    } catch (e) {
      console.warn('Failed to save timer:', e);
    }
  }

  // Timer logic (counts UP from 0:00 to 30:00)
  function startTimer() {
    if (timerInterval) clearInterval(timerInterval);
    updateTimerDisplay();

    timerInterval = setInterval(() => {
      if (timerSecondsElapsed < MAX_DURATION_SECONDS) {
        timerSecondsElapsed++;
        saveTimerState();
        updateTimerDisplay();
      } else {
        clearInterval(timerInterval);
        timerInterval = null;
        alert('⏱️ Batas waktu pengerjaan (30:00) telah tercapai! Jawaban Anda akan otomatis dikumpulkan.');
        submitQuiz(true);
      }
    }, 1000);
  }

  function updateTimerDisplay() {
    if (!timerDisplay) return;
    const mins = Math.floor(timerSecondsElapsed / 60);
    const secs = timerSecondsElapsed % 60;
    const formatted = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    timerDisplay.textContent = `${formatted} / 30:00`;

    if (timerBox) {
      if (timerSecondsElapsed >= 28 * 60) {
        timerBox.classList.add('timer-danger');
        timerBox.classList.remove('timer-warning');
      } else if (timerSecondsElapsed >= 25 * 60) {
        timerBox.classList.add('timer-warning');
        timerBox.classList.remove('timer-danger');
      } else {
        timerBox.classList.remove('timer-warning', 'timer-danger');
      }
    }
  }

  // UI Selection styling
  function markOptionSelected(qId, selectedOpt) {
    const questionCard = document.getElementById(`question-card-${qId}`);
    if (!questionCard) return;

    questionCard.querySelectorAll('.quiz-option-label').forEach((lbl) => {
      lbl.classList.remove('selected');
    });

    const activeLabel = document.getElementById(`option-label-${qId}-${selectedOpt}`);
    if (activeLabel) {
      activeLabel.classList.add('selected');
    }

    const navBtn = document.getElementById(`nav-btn-${qId}`);
    if (navBtn) {
      navBtn.classList.add('answered');
    }
  }

  // Update progress count & bar
  function updateProgressUI() {
    const answeredCount = Object.keys(answers).length;
    if (answeredCountText) {
      answeredCountText.innerHTML = `Terjawab: <strong>${answeredCount}</strong> / ${TOTAL_QUESTIONS}`;
    }
    if (progressBar) {
      const pct = Math.round((answeredCount / TOTAL_QUESTIONS) * 100);
      progressBar.style.width = `${pct}%`;
    }

    quizData.forEach((q) => {
      const navBtn = document.getElementById(`nav-btn-${q.id}`);
      if (navBtn) {
        if (answers[q.id]) {
          navBtn.classList.add('answered');
        } else {
          navBtn.classList.remove('answered');
        }
      }
    });
  }

  // Submit & Score Calculation
  function submitQuiz(force = false) {
    if (isSubmitted) return;

    const answeredCount = Object.keys(answers).length;
    if (!force && answeredCount < TOTAL_QUESTIONS) {
      const unanswered = TOTAL_QUESTIONS - answeredCount;
      const confirmSubmit = window.confirm(
        `⚠️ Masih ada ${unanswered} soal yang belum Anda jawab!\n\nApakah Anda yakin ingin mengumpulkan kuis sekarang?`
      );
      if (!confirmSubmit) return;
    }

    if (timerInterval) {
      clearInterval(timerInterval);
      timerInterval = null;
    }

    isSubmitted = true;
    try {
      localStorage.setItem(STORAGE_KEY_SUBMITTED, 'true');
    } catch (e) {
      console.warn('Failed to save submit state:', e);
    }

    const timeSpentSeconds = Math.min(timerSecondsElapsed, MAX_DURATION_SECONDS);
    const mins = Math.floor(timeSpentSeconds / 60);
    const secs = timeSpentSeconds % 60;
    const formattedTimeSpent = `${mins} menit ${secs} detik`;

    // Calculate score
    let correctCount = 0;
    let incorrectCount = 0;
    let unansweredCount = 0;

    const moduleStats = {
      'Modul 1': { total: 0, correct: 0, title: 'Modul 1: Konsep Dasar Deployment' },
      'Modul 2': { total: 0, correct: 0, title: 'Modul 2: Git dan GitHub' },
      'Modul 3': { total: 0, correct: 0, title: 'Modul 3: Deploy Website Statis' },
      'Modul 4': { total: 0, correct: 0, title: 'Modul 4: Benchmark Performa Lighthouse' },
      'Referensi': { total: 0, correct: 0, title: 'Referensi & Troubleshooting' }
    };

    quizData.forEach((q) => {
      const category = q.moduleCategory;
      if (moduleStats[category]) {
        moduleStats[category].total++;
      }

      const userAnswer = answers[q.id];
      if (!userAnswer) {
        unansweredCount++;
      } else if (userAnswer === q.correctAnswer) {
        correctCount++;
        if (moduleStats[category]) {
          moduleStats[category].correct++;
        }
      } else {
        incorrectCount++;
      }
    });

    const score = Math.round((correctCount / TOTAL_QUESTIONS) * 100);
    const accuracy = Math.round((correctCount / (correctCount + incorrectCount || 1)) * 100);

    const resultData = {
      score,
      correctCount,
      incorrectCount,
      unansweredCount,
      accuracy,
      timeSpentSeconds,
      timeSpentFormatted: formattedTimeSpent,
      moduleStats,
      timestamp: new Date().toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' })
    };

    currentResultData = resultData;

    try {
      localStorage.setItem(STORAGE_KEY_RESULT, JSON.stringify(resultData));
    } catch (e) {
      console.warn('Failed to save result:', e);
    }

    applyReviewMode(resultData);
    if (resultDashboard) {
      resultDashboard.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  // Review Mode UI rendering
  function applyReviewMode(customResult = null) {
    let result = customResult;
    if (!result) {
      try {
        const saved = localStorage.getItem(STORAGE_KEY_RESULT);
        if (saved) result = JSON.parse(saved);
      } catch (e) {
        console.warn('Failed to load result:', e);
      }
    }

    currentResultData = result;

    if (timerInterval) {
      clearInterval(timerInterval);
      timerInterval = null;
    }

    document.querySelectorAll('.quiz-option-input').forEach((input) => {
      input.disabled = true;
    });

    if (btnSubmitTop) btnSubmitTop.style.display = 'none';
    if (btnSubmitBottom) btnSubmitBottom.style.display = 'none';
    document.querySelectorAll('.review-only').forEach((el) => (el.style.display = 'inline-flex'));

    quizData.forEach((q) => {
      const userAnswer = answers[q.id];
      const isCorrect = userAnswer === q.correctAnswer;
      const isAnswered = Boolean(userAnswer);

      const card = document.getElementById(`question-card-${q.id}`);
      const statusBadge = document.getElementById(`status-badge-${q.id}`);
      const navBtn = document.getElementById(`nav-btn-${q.id}`);
      const explanation = document.getElementById(`explanation-${q.id}`);
      const fbCorrect = document.getElementById(`fb-correct-${q.id}`);
      const fbIncorrect = document.getElementById(`fb-incorrect-${q.id}`);

      if (card) {
        card.classList.add('review-mode');
        if (isCorrect) {
          card.classList.add('card-correct');
        } else if (isAnswered) {
          card.classList.add('card-incorrect');
        } else {
          card.classList.add('card-unanswered');
        }
      }

      if (statusBadge) {
        if (isCorrect) {
          statusBadge.innerHTML = `<span class="badge-tag tag-correct">✅ Benar (+5 Poin)</span>`;
        } else if (isAnswered) {
          statusBadge.innerHTML = `<span class="badge-tag tag-incorrect">❌ Salah (Pilihan Anda: ${userAnswer})</span>`;
        } else {
          statusBadge.innerHTML = `<span class="badge-tag tag-unanswered">⚠️ Belum Dijawab</span>`;
        }
      }

      if (navBtn) {
        navBtn.classList.remove('answered');
        if (isCorrect) {
          navBtn.classList.add('nav-correct');
        } else if (isAnswered) {
          navBtn.classList.add('nav-incorrect');
        } else {
          navBtn.classList.add('nav-unanswered');
        }
      }

      // Highlight options
      q.options.forEach((opt) => {
        const label = document.getElementById(`option-label-${q.id}-${opt.id}`);
        const icon = document.getElementById(`opt-icon-${q.id}-${opt.id}`);

        if (label) {
          if (opt.id === q.correctAnswer) {
            label.classList.add('opt-correct-answer');
            if (icon) icon.innerHTML = '✅ Kunci Jawaban';
          } else if (userAnswer === opt.id && !isCorrect) {
            label.classList.add('opt-user-wrong');
            if (icon) icon.innerHTML = '❌ Pilihan Anda';
          }
        }
      });

      if (explanation) {
        explanation.style.display = 'block';
      }

      // Feedback conditional display
      if (isCorrect) {
        if (fbCorrect) fbCorrect.style.display = 'block';
        if (fbIncorrect) fbIncorrect.style.display = 'none';
      } else {
        if (fbCorrect) fbCorrect.style.display = 'none';
        if (fbIncorrect) fbIncorrect.style.display = 'block';
      }
    });

    // Populate and show Result Dashboard
    if (result && resultDashboard) {
      resultDashboard.style.display = 'block';

      const scoreNumber = document.getElementById('result-score-number');
      const scoreCircle = document.getElementById('result-score-circle');
      const statusTitle = document.getElementById('result-status-title');
      const statusMsg = document.getElementById('result-status-message');
      const timeSpentEl = document.getElementById('result-time-spent');
      const timestampEl = document.getElementById('result-timestamp');
      const statCorrect = document.getElementById('stat-correct-count');
      const statIncorrect = document.getElementById('stat-incorrect-count');
      const statUnanswered = document.getElementById('stat-unanswered-count');
      const statAccuracy = document.getElementById('stat-accuracy-rate');
      const moduleList = document.getElementById('module-breakdown-list');

      if (scoreNumber) scoreNumber.textContent = result.score.toString();
      if (timeSpentEl) timeSpentEl.textContent = `⏱️ Waktu Pengerjaan: ${result.timeSpentFormatted || '-'}`;
      if (timestampEl) timestampEl.textContent = `📅 Selesai: ${result.timestamp || '-'}`;
      if (statCorrect) statCorrect.textContent = result.correctCount.toString();
      if (statIncorrect) statIncorrect.textContent = result.incorrectCount.toString();
      if (statUnanswered) statUnanswered.textContent = result.unansweredCount.toString();
      if (statAccuracy) statAccuracy.textContent = `${result.accuracy || 0}%`;

      if (scoreCircle) {
        if (result.score >= 85) {
          scoreCircle.className = 'result-score-circle grade-excellent';
        } else if (result.score >= 70) {
          scoreCircle.className = 'result-score-circle grade-good';
        } else {
          scoreCircle.className = 'result-score-circle grade-poor';
        }
      }

      if (statusTitle && statusMsg) {
        if (result.score >= 85) {
          statusTitle.textContent = '🏆 Luar Biasa! Pemahaman Sempurna';
          statusMsg.textContent = 'Selamat! Anda telah menguasai konsep deployment web di Netlify dengan sangat matang dan siap diaplikasikan pada proyek nyata.';
        } else if (result.score >= 70) {
          statusTitle.textContent = '👍 Bagus! Anda Dinyatakan Lulus';
          statusMsg.textContent = 'Pemahaman Anda sudah baik. Silakan tinjau kembali beberapa soal yang masih salah untuk memperkuat pemahaman teknis.';
        } else {
          statusTitle.textContent = '📚 Perlu Peningkatan & Belajar Ulang';
          statusMsg.textContent = 'Jangan berkecil hati! Pelajari kembali modul pembelajaran terutama pada topik-topik yang belum Anda kuasai, lalu coba kuis kembali.';
        }
      }

      if (moduleList && result.moduleStats) {
        moduleList.innerHTML = Object.entries(result.moduleStats)
          .map(([key, stat]) => {
            const pct = stat.total > 0 ? Math.round((stat.correct / stat.total) * 100) : 0;
            const barClass = pct >= 80 ? 'bar-green' : pct >= 60 ? 'bar-yellow' : 'bar-red';
            return `
              <div class="module-stat-row">
                <div class="mod-info">
                  <span class="mod-name">${stat.title}</span>
                  <span class="mod-score">${stat.correct} / ${stat.total} Benar (${pct}%)</span>
                </div>
                <div class="mod-bar-bg">
                  <div class="mod-bar-fill ${barClass}" style="width: ${pct}%;"></div>
                </div>
              </div>
            `;
          })
          .join('');
      }

      // Check if already submitted to leaderboard
      try {
        const lbSubmitted = localStorage.getItem(STORAGE_KEY_LB_SUBMITTED);
        if (lbSubmitted === 'true' && lbSubmitFeedback) {
          lbSubmitFeedback.style.display = 'block';
          lbSubmitFeedback.className = 'lb-submit-feedback lb-fb-success';
          lbSubmitFeedback.innerHTML = '✅ Skor Anda sudah terdaftar di Leaderboard.';
          if (btnSubmitScoreLb) btnSubmitScoreLb.disabled = true;
        }
      } catch (e) {}
    }
  }

  async function handleLeaderboardSubmit(e) {
    e.preventDefault();

    if (!currentResultData) {
      alert('Selesaikan quiz terlebih dahulu sebelum menyimpan skor!');
      return;
    }

    const name = inputPlayerName?.value.trim();
    const email = inputPlayerEmail?.value.trim();

    if (!name) {
      alert('Nama wajib diisi!');
      return;
    }

    try {
      localStorage.setItem(STORAGE_KEY_PLAYER_NAME, name);
    } catch (e) {}

    if (btnSubmitScoreLb) {
      btnSubmitScoreLb.disabled = true;
      btnSubmitScoreLb.textContent = '⏳ Menyimpan...';
    }

    try {
      const payload = {
        name,
        email: email || undefined,
        score: currentResultData.score,
        correctCount: currentResultData.correctCount,
        timeSpentSeconds: currentResultData.timeSpentSeconds || 0,
        timeSpentFormatted: currentResultData.timeSpentFormatted,
        accuracy: currentResultData.accuracy,
      };

      const res = await fetch('/api/leaderboard', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const json = await res.json();

      if (json.success) {
        try {
          localStorage.setItem(STORAGE_KEY_LB_SUBMITTED, 'true');
        } catch (e) {}

        if (lbSubmitFeedback) {
          lbSubmitFeedback.style.display = 'block';
          lbSubmitFeedback.className = 'lb-submit-feedback lb-fb-success';
          lbSubmitFeedback.innerHTML = `🎉 <strong>Berhasil!</strong> Skor Anda telah disimpan di peringkat <strong>#${json.rank || 1}</strong>.`;
        }

        if (btnSubmitScoreLb) {
          btnSubmitScoreLb.disabled = true;
          btnSubmitScoreLb.textContent = '✅ Skor Tersimpan';
        }

        setTimeout(() => {
          openLeaderboard();
        }, 1000);
      } else {
        if (lbSubmitFeedback) {
          lbSubmitFeedback.style.display = 'block';
          lbSubmitFeedback.className = 'lb-submit-feedback lb-fb-error';
          lbSubmitFeedback.innerHTML = `⚠️ ${json.error || 'Gagal menyimpan skor.'}`;
        }
        if (btnSubmitScoreLb) {
          btnSubmitScoreLb.disabled = false;
          btnSubmitScoreLb.textContent = 'Simpan ke Leaderboard';
        }
      }
    } catch (error) {
      console.error('Submit to leaderboard failed:', error);
      if (lbSubmitFeedback) {
        lbSubmitFeedback.style.display = 'block';
        lbSubmitFeedback.className = 'lb-submit-feedback lb-fb-error';
        lbSubmitFeedback.innerHTML = '⚠️ Terjadi kesalahan jaringan saat menghubungi API Leaderboard.';
      }
      if (btnSubmitScoreLb) {
        btnSubmitScoreLb.disabled = false;
        btnSubmitScoreLb.textContent = 'Simpan ke Leaderboard';
      }
    }
  }

  // Setup Event Listeners
  let listenersAttached = false;
  function setupEventListeners() {
    if (listenersAttached) return;
    listenersAttached = true;

    // Unlock Gate button
    if (btnUnlockGate) {
      btnUnlockGate.addEventListener('click', () => {
        try { localStorage.setItem(STORAGE_KEY_ACCESS, 'true'); } catch (e) {}
        const newUrl = new URL(window.location.href);
        newUrl.searchParams.set('quiz', 'enabled');
        window.history.replaceState({}, '', newUrl.toString());
        checkAccessState();
      });
    }

    // Lock Quiz button
    if (btnLockQuiz) {
      btnLockQuiz.addEventListener('click', () => {
        try { localStorage.removeItem(STORAGE_KEY_ACCESS); } catch (e) {}
        const newUrl = new URL(window.location.href);
        newUrl.searchParams.delete('quiz');
        window.history.replaceState({}, '', newUrl.toString());
        checkAccessState();
      });
    }

    // Leaderboard Modal Triggers
    if (btnOpenLbTop) btnOpenLbTop.addEventListener('click', openLeaderboard);
    if (btnShowLbHeader) btnShowLbHeader.addEventListener('click', openLeaderboard);
    if (btnOpenLbResult) btnOpenLbResult.addEventListener('click', openLeaderboard);
    if (btnViewLbDirect) btnViewLbDirect.addEventListener('click', openLeaderboard);

    // Submit to leaderboard form
    if (lbForm) {
      lbForm.addEventListener('submit', handleLeaderboardSubmit);
    }

    // Radio button changes
    if (quizForm) {
      quizForm.addEventListener('change', (e) => {
        if (isSubmitted) return;
        const target = e.target;
        if (target && target.matches('.quiz-option-input')) {
          const qId = parseInt(target.name.replace('question_', ''), 10);
          const val = target.value;
          answers[qId] = val;
          markOptionSelected(qId, val);
          saveAnswersState();
          updateProgressUI();
        }
      });
    }

    // Nav grid buttons
    document.querySelectorAll('.quiz-nav-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-question-target');
        const targetCard = document.getElementById(`question-card-${targetId}`);
        if (targetCard) {
          resetFilterToAll();
          targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
          targetCard.classList.add('highlight-pulse');
          setTimeout(() => targetCard.classList.remove('highlight-pulse'), 1200);
        }
      });
    });

    // Filter tabs
    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        filterTabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        const filterVal = tab.getAttribute('data-filter');
        applyFilter(filterVal);
      });
    });

    // Submit buttons
    if (btnSubmitTop) btnSubmitTop.addEventListener('click', () => submitQuiz(false));
    if (btnSubmitBottom) btnSubmitBottom.addEventListener('click', () => submitQuiz(false));

    // Reset buttons
    if (btnResetTop) btnResetTop.addEventListener('click', confirmResetQuiz);
    if (btnResetBottom) btnResetBottom.addEventListener('click', confirmResetQuiz);
    if (btnRestartQuiz) btnRestartQuiz.addEventListener('click', confirmResetQuiz);

    // Scroll to questions from results
    if (btnScrollQuestions && quizForm) {
      btnScrollQuestions.addEventListener('click', () => {
        quizForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
  }

  function resetFilterToAll() {
    filterTabs.forEach((t) => {
      if (t.getAttribute('data-filter') === 'all') {
        t.classList.add('active');
      } else {
        t.classList.remove('active');
      }
    });
    applyFilter('all');
  }

  function applyFilter(filterVal) {
    const cards = document.querySelectorAll('.quiz-question-card');
    cards.forEach((card) => {
      const modCategory = card.getAttribute('data-module-category');
      if (filterVal === 'all' || modCategory === filterVal) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }

  // Reset quiz logic
  function confirmResetQuiz() {
    const confirmReset = window.confirm(
      '🔄 Apakah Anda yakin ingin mengulang quiz dari awal?\n\nSeluruh jawaban dan skor lokal akan dihapus.'
    );
    if (!confirmReset) return;

    try {
      localStorage.removeItem(STORAGE_KEY_ANSWERS);
      localStorage.removeItem(STORAGE_KEY_SUBMITTED);
      localStorage.removeItem(STORAGE_KEY_TIMER_ELAPSED);
      localStorage.removeItem(STORAGE_KEY_RESULT);
      localStorage.removeItem(STORAGE_KEY_LB_SUBMITTED);
    } catch (e) {
      console.warn('Failed to clear storage:', e);
    }

    window.location.reload();
  }

  // Start check on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', checkAccessState);
  } else {
    checkAccessState();
  }
})();
</script>

